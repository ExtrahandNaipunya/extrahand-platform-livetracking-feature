# Copy this file to .env.local and fill in your actual values

# Google Maps Configuration
NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIzaSy...your_key_here
GOOGLE_DISTANCE_MATRIX_KEY=AIzaSy...your_key_here

# Redis Configuration (Upstash recommended for serverless)
# Get free tier at: https://upstash.com
REDIS_URL=https://your-redis-url.upstash.io
REDIS_TOKEN=your_redis_token_here

# Database Configuration
# MongoDB Atlas (recommended): https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/extrahand-maps?retryWrites=true&w=majority

# WebSocket Security
WEBSOCKET_SECRET=your_random_secret_key_here

# Optional: Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
