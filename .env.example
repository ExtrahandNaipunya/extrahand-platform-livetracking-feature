# Google Maps Configuration
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_api_key_here
GOOGLE_DISTANCE_MATRIX_KEY=your_distance_matrix_api_key_here

# Redis Configuration (Upstash or self-hosted)
REDIS_URL=your_redis_url_here
REDIS_TOKEN=your_redis_token_here

# Database Configuration (Choose one)
MONGODB_URI=mongodb://localhost:27017/extrahand-maps
# POSTGRES_URL=postgresql://user:password@localhost:5432/extrahand

# WebSocket Security
WEBSOCKET_SECRET=your_secure_websocket_secret_here

# Environment
NODE_ENV=development
